#!/usr/bin/env bash
# sakuro-bench launcher: keeps its own venv, touches nothing system-wide.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$HERE/.venv"
PY="${SAKURO_BENCH_PYTHON:-python3}"

if [[ ! -x "$VENV/bin/python" ]]; then
  echo "[sakuro-bench] creating venv…" >&2
  "$PY" -m venv "$VENV"
  "$VENV/bin/pip" install -q --upgrade pip >/dev/null
  "$VENV/bin/pip" install -q -r "$HERE/requirements.txt"
fi
exec "$VENV/bin/python" -m sakuro_bench "$@"
