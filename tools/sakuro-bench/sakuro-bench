#!/usr/bin/env bash
# Лаунчер sakuro-bench: держит собственный venv, ничего в системе не трогает.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$HERE/.venv"
PY="${SAKURO_BENCH_PYTHON:-python3}"

if [[ ! -x "$VENV/bin/python" ]]; then
  echo "[sakuro-bench] создаю venv…" >&2
  "$PY" -m venv "$VENV"
  "$VENV/bin/pip" install -q --upgrade pip >/dev/null
  "$VENV/bin/pip" install -q -r "$HERE/requirements.txt"
fi
exec "$VENV/bin/python" -m sakuro_bench "$@"
