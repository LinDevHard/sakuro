<?xml version="1.0" encoding="utf-8"?>
<!--
    Stream links are entered by the user, and many IPTV/CDN/home-server streams are plain
    http://, so cleartext is allowed everywhere. Only system CAs are trusted (no user CAs).
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
